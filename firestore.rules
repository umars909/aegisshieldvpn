rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserAccount
    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 256;
    }

    // Validation for VpnSession
    function isValidSession(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.serverId is string && data.serverId.size() <= 128;
    }

    // Validation for SubscriptionInvoice
    function isValidInvoice(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.plan is string && data.plan.size() <= 64
        && data.amount is number && data.amount >= 0;
    }

    // Test connection doc (for connectivity test)
    match /test/connection {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User VPN sessions subcollection
      match /sessions/{sessionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidSession(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidSession(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }

      // User invoices subcollection
      match /invoices/{invoiceId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(invoiceId) && isValidInvoice(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(invoiceId) && isValidInvoice(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(invoiceId);
      }
    }
  }
}
